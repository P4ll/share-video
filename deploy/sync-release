#!/bin/bash
set -euo pipefail
umask 077
cd /opt/share-video

repository=https://github.com/P4ll/share-video.git
tested_ref=refs/heads/deploy/production
refs=$(git ls-remote "$repository" refs/heads/main "$tested_ref")
revision=$(awk '$2 == "refs/heads/main" {print $1}' <<< "$refs")
tested=$(awk -v ref="$tested_ref" '$2 == ref {print $1}' <<< "$refs")
if [[ ! $revision =~ ^[0-9a-f]{40}$ ]]; then
    echo 'GitHub did not return a full main revision' >&2
    exit 1
fi
[[ $revision == "$tested" ]] || exit 0
previous=
if [[ -s state/revision ]]; then
    previous=$(<state/revision)
fi
[[ $revision != "$previous" ]] || exit 0
if [[ -s .failed-revision && $revision == "$(<.failed-revision)" ]]; then
    exit 0
fi

source_dir=$(mktemp -d)
trap 'rm -rf "$source_dir"' EXIT
git clone --quiet --depth 1 --branch deploy/production --no-tags "$repository" "$source_dir"
[[ $(git -C "$source_dir" rev-parse HEAD) == "$revision" ]] || exit 0

image="share-video:$revision"
docker build --label "org.opencontainers.image.revision=$revision" --tag "$image" "$source_dir"
# Don't replace a working release with an obsolete build.
[[ $(git ls-remote "$repository" refs/heads/main "$tested_ref") == "$refs" ]] || exit 0

activate() {
    APP_IMAGE="share-video:$1" docker compose up -d --no-build --pull never || return
    curl --noproxy '*' --silent --show-error --fail --retry 8 --retry-all-errors --retry-delay 1 \
        --max-time 3 --retry-max-time 20 http://127.0.0.1:8080/api/health >/dev/null
}

if activate "$revision"; then
    printf '%s\n' "$revision" > state/revision.tmp
    chmod 0644 state/revision.tmp
    mv -f state/revision.tmp state/revision
    printf 'Deployed %s\n' "$revision"
else
    printf '%s\n' "$revision" > .failed-revision
    if [[ -n $previous ]]; then
        [[ $previous =~ ^[0-9a-f]{40}$ ]] || exit 1
        # Leave the last healthy revision published while restoring its image.
        printf 'Deployment failed; restoring %s\n' "$previous" >&2
        activate "$previous" || echo 'Could not restore the previous release' >&2
    else
        APP_IMAGE="$image" docker compose stop app || true
    fi
    exit 1
fi
